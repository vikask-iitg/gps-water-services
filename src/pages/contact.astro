---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import OrderForm from '../components/OrderForm.astro';
import WaButton from '../components/WaButton.astro';
import { business, faqs } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q.hi, acceptedAnswer: { '@type': 'Answer', text: f.a.hi } })),
};
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(business.mapQuery)}&output=embed`;
const dirUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(business.mapQuery)}`;
---
<Base title={{ hi: 'संपर्क और सवाल-जवाब', en: 'Contact & FAQ' }} description={{ hi: 'GPS वाटर सर्विसेज़ से संपर्क करें: फ़ोन, व्हाट्सऐप, पता और नक्शा।', en: 'Contact GPS Water Services: phone, WhatsApp, address and map.' }}>
  <PageHero title={{ hi: 'संपर्क, सवाल', en: 'Contact & FAQ' }} lead={{ hi: 'फ़ोन करें, व्हाट्सऐप करें या फ़ॉर्म भरें — हम जल्दी जवाब देंगे।', en: 'Call, WhatsApp or fill the form and we will reply quickly.' }} />

  <section class="section">
    <div class="wrap two-col">
      <div class="grid">
        <div class="card grid" style="gap:14px">
          <ul class="info-list">
            <li><span class="info-ic"><Icon name="pin" size={20} /></span><span><small><T hi="पता" en="Address" /></small><T {...business.address} /></span></li>
            <li><span class="info-ic"><Icon name="phone" size={20} /></span><span><small><T hi="कॉल / व्हाट्सऐप" en="Call / WhatsApp" /></small><a class="info-phone" href={`tel:${business.phoneRaw}`} data-track="call">{business.phone}</a></span></li>
            <li><span class="info-ic"><Icon name="clock" size={20} /></span><span><small><T hi="समय" en="Timings" /></small><T {...business.hours} /></span></li>
          </ul>
          <div class="btn-row">
            <WaButton hi="नमस्ते GPS वाटर, मुझे जानकारी चाहिए।" en="Hello GPS Water, I have a question."><T hi="व्हाट्सऐप करें" en="WhatsApp us" /></WaButton>
            <a class="btn btn-ghost" href={dirUrl} target="_blank" rel="noopener"><Icon name="pin" size={20} /> <T hi="रास्ता देखें" en="Get directions" /></a>
          </div>
        </div>
        <iframe class="map" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="GPS Water Services map"></iframe>
      </div>
      <OrderForm />
    </div>
  </section>

  <section class="section section-frost" id="faq">
    <div class="wrap" style="max-width:820px">
      <div class="section-head"><span class="eyebrow">FAQ</span><h2><T hi="अक्सर पूछे जाने वाले सवाल" en="Frequently asked questions" /></h2></div>
      <div class="faq">
        {faqs.map((f, i) => <details open={i === 0}><summary><T {...f.q} /></summary><p><T {...f.a} /></p></details>)}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
