---
import T from './T.astro';
import Wave from './Wave.astro';
import type { Bi } from '../data/site';
interface Props { title: Bi; lead: Bi; crumb?: Bi }
const { title, lead, crumb } = Astro.props;
---
<section class="hero">
  <div class="wrap page-hero">
    <div class="inner">
      <div class="crumbs"><a href="/"><T hi="होम" en="Home" /></a> / <T {...(crumb ?? title)} /></div>
      <h1><T {...title} /></h1>
      <p><T {...lead} /></p>
      <slot />
    </div>
  </div>
  <Wave color="var(--bg)" />
</section>
