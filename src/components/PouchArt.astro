---
// पानी पाउच — तकिया जैसा सीलबंद पाउच, एनिमेशन के साथ
interface Props { size?: number }
const { size = 56 } = Astro.props;
---
<svg class="pouch-art" width={size} height={Math.round(size * 0.55)} viewBox="0 0 140 77" aria-hidden="true">
  <defs>
    <linearGradient id="pouchBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#DDF0FD" />
      <stop offset=".45" stop-color="#9FD0F2" />
      <stop offset="1" stop-color="#5DA6DE" />
    </linearGradient>
    <linearGradient id="pouchSeal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#D6ECFA" /><stop offset="1" stop-color="#8FC2E8" /></linearGradient>
    <linearGradient id="pouchShine" x1="0" x2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".8" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id="pouchClip"><path d="M17 13C48 4 92 4 123 13Q129 36 123 59C92 68 48 68 17 59Q11 36 17 13Z" /></clipPath>
  </defs>

  <g class="pouch-squish">
    <ellipse cx="70" cy="72" rx="54" ry="4" fill="#0B4F8A" opacity=".2" />

    <!-- सील वाले सिरे (zig-zag crimp) -->
    <g fill="url(#pouchSeal)" stroke="#3F86C4" stroke-width="1.3" stroke-linejoin="round">
      <path d="M16 13 L6 13 L8 17 L6 21 L8 25 L6 29 L8 33 L6 37 L8 41 L6 45 L8 49 L6 53 L8 57 L6 59 L16 59 Z" />
      <path d="M124 13 L134 13 L132 17 L134 21 L132 25 L134 29 L132 33 L134 37 L132 41 L134 45 L132 49 L134 53 L132 57 L134 59 L124 59 Z" />
    </g>
    <path d="M10.5 15v42M13 15v42M127 15v42M129.5 15v42" stroke="#4F92CC" stroke-width="1" opacity=".9" />

    <!-- पाउच का शरीर -->
    <path d="M17 13C48 4 92 4 123 13Q129 36 123 59C92 68 48 68 17 59Q11 36 17 13Z" fill="url(#pouchBody)" stroke="#2F79BD" stroke-width="1.8" />

    <g clip-path="url(#pouchClip)">
      <path class="pouch-wave" d="M-40 40q10-5 20 0t20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0 20 0V90H-40Z" fill="#2F86D6" opacity=".38" />
      <g stroke="#1F6FBF" stroke-width="1.3" stroke-linecap="round" opacity=".45">
        <path d="M24 18v6M30 27v5M23 38v6M31 47v5M26 54v4M40 54v4M100 54v4M110 18v6M116 28v5M108 40v6M117 48v5M112 56v3" />
      </g>
      <g fill="#fff" opacity=".85">
        <circle class="pouch-bub b1" cx="40" cy="56" r="1.8" />
        <circle class="pouch-bub b2" cx="80" cy="58" r="1.4" />
        <circle class="pouch-bub b3" cx="102" cy="56" r="2" />
      </g>
      <rect class="pouch-shine" x="-30" y="0" width="24" height="80" fill="url(#pouchShine)" transform="skewX(-20)" />
    </g>

    <!-- लेबल -->
    <text x="70" y="31" text-anchor="middle" font-family="Baloo 2, Poppins, sans-serif" font-weight="800" font-size="16" fill="#B3122E">GPS</text>
    <text x="70" y="42" text-anchor="middle" font-family="Inter, Mukta, sans-serif" font-weight="800" font-size="8.5" fill="#0B4F8A" letter-spacing=".4">AQUA WATER</text>
    <text x="70" y="50" text-anchor="middle" font-family="Inter, Mukta, sans-serif" font-size="5.2" fill="#0B4F8A">Purified Drinking Water</text>

    <path d="M26 15C50 9 90 9 114 15" stroke="#fff" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".85" />
  </g>
</svg>

<style>
  .pouch-art { display: block; overflow: visible; }
  .pouch-art * { transform-box: fill-box; }
  .pouch-squish { transform-origin: 50% 90%; animation: pouchSquish 3.2s ease-in-out infinite; }
  @keyframes pouchSquish {
    0%, 100% { transform: scale(1, 1); }
    50% { transform: scale(1.03, .96); }
  }
  .pouch-wave { animation: pouchWave 2.6s linear infinite; }
  @keyframes pouchWave { to { transform: translateX(40px); } }
  .pouch-bub { opacity: 0; animation: pouchBub 3s ease-in infinite; }
  .b2 { animation-delay: 1s; }
  .b3 { animation-delay: 2s; }
  @keyframes pouchBub {
    0% { opacity: 0; transform: translateY(0); }
    20% { opacity: .9; }
    100% { opacity: 0; transform: translateY(-34px); }
  }
  .pouch-shine { animation: pouchShine 4.5s ease-in-out infinite; }
  @keyframes pouchShine {
    0%, 55% { transform: skewX(-20deg) translateX(0); }
    100% { transform: skewX(-20deg) translateX(220px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pouch-art * { animation: none !important; }
    .pouch-bub { opacity: 0; }
  }
</style>
