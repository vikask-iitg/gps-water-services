---
// बर्फ़ सिल्ली — कतार में खड़ी सिल्लियाँ, ठंडी भाप के साथ
interface Props { size?: number }
const { size = 56 } = Astro.props;
---
<svg class="ice-art" width={size} height={Math.round(size * 0.82)} viewBox="0 0 132 108" aria-hidden="true">
  <defs>
    <linearGradient id="iceTop" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFFFFF" /><stop offset="1" stop-color="#E4F3FA" /></linearGradient>
    <linearGradient id="iceFace" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7FCFF" /><stop offset=".5" stop-color="#CFE6F4" /><stop offset="1" stop-color="#93C1E0" /></linearGradient>
    <linearGradient id="iceEnd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A9D0E8" /><stop offset="1" stop-color="#5E9CC9" /></linearGradient>
    <filter id="iceMist" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.2" /></filter>
  </defs>
  <ellipse cx="72" cy="101" rx="50" ry="5" fill="#0B4F8A" opacity=".14" />
    <g class="slab s0">
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="12.0,30.0 25.0,37.0 25.0,77.0 12.0,70.0" fill="url(#iceEnd)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="25.0,37.0 65.0,22.0 65.0,62.0 25.0,77.0" fill="url(#iceFace)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="12.0,30.0 52.0,15.0 65.0,22.0 25.0,37.0" fill="url(#iceTop)" />
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"><path d="M33.0 39.0v14"/><path d="M43.0 35.2v22"/><path d="M53.0 31.5v11"/><path d="M60.2 28.8v18"/></g>
      <polyline points="12.0,30.0 25.0,37.0 65.0,22.0" fill="none" stroke="#fff" stroke-width="1.2" opacity=".9" />
      <polyline points="25.0,37.0 25.0,77.0" fill="none" stroke="#6FA6CF" stroke-width=".9" />
    </g>
    <g class="slab s1">
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="29.0,40.0 42.0,47.0 42.0,87.0 29.0,80.0" fill="url(#iceEnd)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="42.0,47.0 82.0,32.0 82.0,72.0 42.0,87.0" fill="url(#iceFace)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="29.0,40.0 69.0,25.0 82.0,32.0 42.0,47.0" fill="url(#iceTop)" />
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"><path d="M50.0 49.0v14"/><path d="M60.0 45.2v22"/><path d="M70.0 41.5v11"/><path d="M77.2 38.8v18"/></g>
      <polyline points="29.0,40.0 42.0,47.0 82.0,32.0" fill="none" stroke="#fff" stroke-width="1.2" opacity=".9" />
      <polyline points="42.0,47.0 42.0,87.0" fill="none" stroke="#6FA6CF" stroke-width=".9" />
    </g>
    <g class="slab s2">
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="46.0,50.0 59.0,57.0 59.0,97.0 46.0,90.0" fill="url(#iceEnd)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="59.0,57.0 99.0,42.0 99.0,82.0 59.0,97.0" fill="url(#iceFace)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="46.0,50.0 86.0,35.0 99.0,42.0 59.0,57.0" fill="url(#iceTop)" />
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"><path d="M67.0 59.0v14"/><path d="M77.0 55.2v22"/><path d="M87.0 51.5v11"/><path d="M94.2 48.8v18"/></g>
      <polyline points="46.0,50.0 59.0,57.0 99.0,42.0" fill="none" stroke="#fff" stroke-width="1.2" opacity=".9" />
      <polyline points="59.0,57.0 59.0,97.0" fill="none" stroke="#6FA6CF" stroke-width=".9" />
    </g>
    <g class="slab s3">
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="63.0,60.0 76.0,67.0 76.0,107.0 63.0,100.0" fill="url(#iceEnd)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="76.0,67.0 116.0,52.0 116.0,92.0 76.0,107.0" fill="url(#iceFace)" />
      <polygon stroke="#6FA6CF" stroke-width="1" stroke-linejoin="round" points="63.0,60.0 103.0,45.0 116.0,52.0 76.0,67.0" fill="url(#iceTop)" />
      <g stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"><path d="M84.0 69.0v14"/><path d="M94.0 65.2v22"/><path d="M104.0 61.5v11"/><path d="M111.2 58.8v18"/></g>
      <polyline points="63.0,60.0 76.0,67.0 116.0,52.0" fill="none" stroke="#fff" stroke-width="1.2" opacity=".9" />
      <polyline points="76.0,67.0 76.0,107.0" fill="none" stroke="#6FA6CF" stroke-width=".9" />
    </g>
  <!-- ठंडी भाप -->
  <g filter="url(#iceMist)" fill="#fff">
    <ellipse class="mist m1" cx="52" cy="22" rx="16" ry="5" />
    <ellipse class="mist m2" cx="84" cy="30" rx="18" ry="5" />
    <ellipse class="mist m3" cx="68" cy="16" rx="12" ry="4" />
  </g>
  <g fill="#fff">
    <path class="ice-spark k1" d="M30 18l1.6 3.4 3.4 1.6-3.4 1.6-1.6 3.4-1.6-3.4-3.4-1.6 3.4-1.6z" />
    <path class="ice-spark k2" d="M112 30l1.3 2.7 2.7 1.3-2.7 1.3-1.3 2.7-1.3-2.7-2.7-1.3 2.7-1.3z" />
  </g>
</svg>

<style>
  .ice-art { display: block; overflow: visible; }
  .ice-art * { transform-box: fill-box; transform-origin: center; }
  .mist { opacity: 0; animation: iceMist 4.5s ease-in-out infinite; }
  .m2 { animation-delay: 1.5s; }
  .m3 { animation-delay: 3s; }
  @keyframes iceMist {
    0% { opacity: 0; transform: translate(0, 6px) scale(.7); }
    35% { opacity: .9; }
    100% { opacity: 0; transform: translate(10px, -16px) scale(1.4); }
  }
  .ice-spark { animation: iceSpark 2.6s ease-in-out infinite; }
  .k2 { animation-delay: -1.3s; }
  @keyframes iceSpark {
    0%, 100% { opacity: .15; transform: scale(.5) rotate(0); }
    50% { opacity: 1; transform: scale(1.1) rotate(45deg); }
  }
  .slab { animation: iceGlint 5s ease-in-out infinite; }
  .s1 { animation-delay: .25s; } .s2 { animation-delay: .5s; } .s3 { animation-delay: .75s; }
  @keyframes iceGlint { 0%, 80%, 100% { filter: none; } 88% { filter: brightness(1.08); } }
  @media (prefers-reduced-motion: reduce) {
    .ice-art * { animation: none !important; }
    .mist { opacity: .5; }
  }
</style>
