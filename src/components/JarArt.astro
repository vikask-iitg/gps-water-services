---
// 18 ली. इंसुलेटेड कैंपर जार — एनिमेशन के साथ
interface Props { size?: number }
const { size = 48 } = Astro.props;
---
<svg class="jar-art" width={Math.round(size * 0.8)} height={size} viewBox="0 0 80 100" aria-hidden="true">
  <defs>
    <linearGradient id="jarBody" x1="0" x2="1">
      <stop offset="0" stop-color="#1F74CF" /><stop offset=".28" stop-color="#4FA6F2" /><stop offset=".65" stop-color="#2A86E0" /><stop offset="1" stop-color="#1559AE" />
    </linearGradient>
    <linearGradient id="jarLid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7CC2FA" /><stop offset="1" stop-color="#2C86DE" />
    </linearGradient>
    <linearGradient id="jarBand" x1="0" x2="1">
      <stop offset="0" stop-color="#E3EEF8" /><stop offset=".35" stop-color="#FFFFFF" /><stop offset="1" stop-color="#DCE8F4" />
    </linearGradient>
    <linearGradient id="jarShine" x1="0" x2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".55" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id="jarClip"><rect x="13" y="24" width="54" height="68" rx="8" /></clipPath>
    <clipPath id="jarBandClip"><rect x="13" y="38" width="54" height="28" /></clipPath>
  </defs>

  <ellipse cx="40" cy="95" rx="28" ry="3.5" fill="#0B4F8A" opacity=".16" />

  <!-- शरीर -->
  <rect x="13" y="24" width="54" height="68" rx="8" fill="url(#jarBody)" />
  <path d="M13 31h54M13 70h54M13 88h54" stroke="#0F4F9C" stroke-opacity=".35" stroke-width="1.2" />

  <!-- सफ़ेद बैंड -->
  <rect x="13" y="38" width="54" height="28" fill="url(#jarBand)" />
  <g clip-path="url(#jarBandClip)">
    <path d="M8 61q16-9 34-5t34-4v18H8z" fill="#2E8BE0" opacity=".85" />
    <path d="M8 59q16-8 34-4.5t34-4" stroke="#7FD3F0" stroke-width="1.6" fill="none" />
    <g fill="#DFF6FB" stroke="#8CC8EC" stroke-width=".8">
      <rect class="jar-cube c1" x="19" y="46" width="8" height="8" rx="1.6" />
      <rect class="jar-cube c2" x="26" y="50" width="7" height="7" rx="1.4" />
    </g>
    <text x="48" y="49" text-anchor="middle" font-family="Baloo 2, Poppins, sans-serif" font-weight="800" font-size="11" fill="#B3122E">GPS</text>
    <text x="48" y="55" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="4" fill="#0B4F8A">18 L COOL</text>
  </g>
  <path d="M13 38h54M13 66h54" stroke="#0F4F9C" stroke-opacity=".25" stroke-width="1" />
  <!-- नल -->
  <path d="M31 92V77a9 9 0 0 1 18 0v15z" fill="#1559AE" opacity=".55" />
  <rect x="37.6" y="80" width="4.8" height="9" rx="2" fill="#F4F8FC" stroke="#C3D3E4" stroke-width=".7" />
  <circle cx="40" cy="78" r="5.2" fill="#fff" stroke="#C3D3E4" stroke-width=".8" />
  <circle cx="40" cy="78" r="2.6" fill="none" stroke="#2EC4D6" stroke-width="1.2" />
  <circle cx="40" cy="78" r=".9" fill="#B3122E" />

  <!-- ढक्कन -->
  <rect x="11" y="14" width="58" height="14" rx="5" fill="url(#jarLid)" />
  <g stroke="#1E6CC4" stroke-opacity=".45" stroke-width="1.4" stroke-linecap="round">
    <path d="M16 17v8M21 16.5v9M26 16.3v9.4M54 16.3v9.4M59 16.5v9M64 17v8" />
  </g>
  <ellipse cx="40" cy="15" rx="15" ry="4" fill="#5EAEF6" />
  <ellipse cx="40" cy="14.5" rx="7" ry="2.2" fill="#E8F4FF" />

  <!-- चमक -->
  <g clip-path="url(#jarClip)">
    <rect x="18" y="24" width="4" height="66" rx="2" fill="#fff" opacity=".28" />
    <rect class="jar-shine" x="-20" y="20" width="14" height="76" fill="url(#jarShine)" transform="skewX(-12)" />
  </g>

  <!-- ठंडक की बूँदें -->
  <g fill="#fff" opacity=".9">
    <path class="jar-drip d1" d="M60 30c0 0 2.4 2.8 2.4 4.3a2.4 2.4 0 0 1-4.8 0c0-1.5 2.4-4.3 2.4-4.3z" />
    <path class="jar-drip d2" d="M58 72c0 0 2 2.4 2 3.6a2 2 0 0 1-4 0c0-1.2 2-3.6 2-3.6z" />
  </g>
  <path class="jar-tapdrop" d="M40 90c0 0 1.6 1.9 1.6 2.9a1.6 1.6 0 0 1-3.2 0c0-1 1.6-2.9 1.6-2.9z" fill="#7FD3F0" />
  <path class="jar-spark" d="M72 10l1.4 3 3 1.4-3 1.4-1.4 3-1.4-3-3-1.4 3-1.4z" fill="#7FE3F0" />
</svg>

<style>
  .jar-art { display: block; overflow: visible; }
  .jar-art * { transform-box: fill-box; transform-origin: center; }
  .jar-drip { animation: jarDrip 4s ease-in infinite; }
  .d2 { animation-delay: 2s; }
  @keyframes jarDrip {
    0%, 15% { opacity: 0; transform: translateY(0); }
    30% { opacity: .9; }
    85% { opacity: .9; transform: translateY(12px); }
    100% { opacity: 0; transform: translateY(14px); }
  }
  .jar-cube { animation: jarCube 3s ease-in-out infinite; }
  .c2 { animation-delay: -1.5s; }
  @keyframes jarCube { 50% { transform: translateY(-1.5px) rotate(8deg); } }
  .jar-shine { animation: jarShine 4.5s ease-in-out infinite; }
  @keyframes jarShine {
    0%, 55% { transform: skewX(-12deg) translateX(0); }
    100% { transform: skewX(-12deg) translateX(110px); }
  }
  .jar-spark { animation: jarSpark 2.6s ease-in-out infinite; }
  @keyframes jarSpark {
    0%, 100% { opacity: .2; transform: scale(.5) rotate(0); }
    50% { opacity: 1; transform: scale(1.1) rotate(45deg); }
  }
  .jar-tapdrop { opacity: 0; animation: jarTap 2.2s ease-in infinite; }
  @keyframes jarTap {
    0% { opacity: 0; transform: translateY(-2px) scale(.4); }
    25% { opacity: 1; transform: translateY(0) scale(1); }
    70% { opacity: 1; transform: translateY(4px); }
    100% { opacity: 0; transform: translateY(6px) scaleX(1.5) scaleY(.4); }
  }
  @media (prefers-reduced-motion: reduce) { .jar-art * { animation: none !important; } .jar-tapdrop { opacity: 0; } }
</style>
