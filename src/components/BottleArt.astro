---
// पैक्ड पीने का पानी — पारदर्शी PET बोतल, एनिमेशन के साथ
interface Props { size?: number }
const { size = 56 } = Astro.props;
const body = 'M19 17H31V22C31 28 42 32 42 42V57C42 60 40 61.5 40 63.5C40 65.5 42 67 42 70V106C42 111 39 114 34 114H16C11 114 8 111 8 106V70C8 67 10 65.5 10 63.5C10 61.5 8 60 8 57V42C8 32 19 28 19 22Z';
---
<svg class="bottle-art" width={Math.round(size * 0.45)} height={size} viewBox="0 0 50 120" aria-hidden="true">
  <defs>
    <linearGradient id="btlPlastic" x1="0" x2="1">
      <stop offset="0" stop-color="#A9D3F0" /><stop offset=".3" stop-color="#EAF6FE" /><stop offset=".55" stop-color="#F8FCFF" /><stop offset="1" stop-color="#9CCBEC" />
    </linearGradient>
    <linearGradient id="btlWater" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8CCBF2" stop-opacity=".55" /><stop offset="1" stop-color="#3E93D8" stop-opacity=".6" />
    </linearGradient>
    <linearGradient id="btlCap" x1="0" x2="1">
      <stop offset="0" stop-color="#1557B8" /><stop offset=".4" stop-color="#3B86E8" /><stop offset="1" stop-color="#0F4A9E" />
    </linearGradient>
    <linearGradient id="btlShine" x1="0" x2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".7" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id="btlClip"><path d={body} /></clipPath>
  </defs>

  <ellipse cx="25" cy="116" rx="16" ry="2.6" fill="#0B4F8A" opacity=".18" />

  <!-- बोतल -->
  <path d={body} fill="url(#btlPlastic)" />
  <g clip-path="url(#btlClip)">
    <!-- पानी -->
    <path class="btl-wave" d="M-30 30q5-2.5 10 0t10 0 10 0 10 0 10 0 10 0 10 0 10 0 10 0V120H-30Z" fill="url(#btlWater)" />
    <!-- ग्रिप की रेखाएँ -->
    <path d="M8 47h34M8 51.5h34M8 99h34M8 103h34" stroke="#5C9FD3" stroke-width="1" opacity=".55" />
    <!-- लेबल -->
    <rect x="6" y="72" width="38" height="22" fill="#fff" />
    <rect x="6" y="72" width="38" height="2.4" fill="#2E8BE0" />
    <rect x="6" y="91.6" width="38" height="2.4" fill="#2E8BE0" />
    <ellipse cx="25" cy="83" rx="11.5" ry="7" fill="#0B4F8A" />
    <text x="25" y="86.4" text-anchor="middle" font-family="Baloo 2, Poppins, sans-serif" font-weight="800" font-size="9.5" fill="#fff">GPS</text>
    <!-- बुलबुले -->
    <g fill="#fff">
      <circle class="btl-bub b1" cx="16" cy="108" r="1.2" />
      <circle class="btl-bub b2" cx="31" cy="110" r="1" />
      <circle class="btl-bub b3" cx="36" cy="106" r="1.3" />
    </g>
    <!-- चमक -->
    <rect x="12" y="30" width="3" height="78" rx="1.5" fill="#fff" opacity=".55" />
    <rect class="btl-shine" x="-16" y="10" width="10" height="110" fill="url(#btlShine)" />
  </g>
  <path d={body} fill="none" stroke="#3F86C4" stroke-width="1.4" stroke-linejoin="round" />

  <!-- ढक्कन -->
  <rect x="16.5" y="14.5" width="17" height="3" rx="1.4" fill="#2C78D6" />
  <rect x="18" y="3" width="14" height="11.5" rx="2" fill="url(#btlCap)" />
  <path d="M20.5 4.5v8.5M23 4.5v8.5M25.5 4.5v8.5M28 4.5v8.5M30.5 4.5v8.5" stroke="#0B3F86" stroke-width=".7" opacity=".6" />
</svg>

<style>
  .bottle-art { display: block; overflow: visible; }
  .bottle-art * { transform-box: fill-box; transform-origin: center; }
  .btl-wave { animation: btlWave 2.4s linear infinite; }
  @keyframes btlWave { to { transform: translateX(20px); } }
  .btl-bub { opacity: 0; animation: btlBub 3.2s ease-in infinite; }
  .b2 { animation-delay: 1.1s; }
  .b3 { animation-delay: 2.2s; }
  @keyframes btlBub {
    0% { opacity: 0; transform: translateY(0); }
    20% { opacity: .9; }
    100% { opacity: 0; transform: translateY(-70px); }
  }
  .btl-shine { animation: btlShine 4.5s ease-in-out infinite; }
  @keyframes btlShine {
    0%, 55% { transform: translateX(0); }
    100% { transform: translateX(70px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bottle-art * { animation: none !important; }
    .btl-bub { opacity: 0; }
  }
</style>
