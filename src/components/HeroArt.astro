---
// इंसुलेटेड चिल्ड कैंपर जार — एनिमेशन के साथ (असली फ़ोटो मिलने पर बदल सकते हैं)
---
<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 400 470">
    <defs>
      <linearGradient id="cBlue" x1="0" x2="1">
        <stop offset="0" stop-color="#1F7BD8" /><stop offset=".3" stop-color="#4FAAF5" /><stop offset=".7" stop-color="#2A8BE6" /><stop offset="1" stop-color="#1667C0" />
      </linearGradient>
      <linearGradient id="cBand" x1="0" x2="1">
        <stop offset="0" stop-color="#E4EEFB" /><stop offset=".35" stop-color="#FFFFFF" /><stop offset="1" stop-color="#DCE8F8" />
      </linearGradient>
      <linearGradient id="cLid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6BB8F8" /><stop offset="1" stop-color="#1E7AD6" />
      </linearGradient>
      <radialGradient id="glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#2EC4D6" stop-opacity=".5" /><stop offset="1" stop-color="#2EC4D6" stop-opacity="0" /></radialGradient>
      <clipPath id="bandClip"><path d="M90 150h220l6 140H84z" /></clipPath>
    </defs>

    <circle cx="200" cy="250" r="205" fill="url(#glow)" />
    <ellipse cx="200" cy="440" rx="135" ry="14" fill="#000" opacity=".2" />

    <!-- ढक्कन -->
    <rect x="96" y="36" width="208" height="32" rx="14" fill="url(#cLid)" />
    <path d="M116 40v24M136 40v24M156 40v24M176 40v24M196 40v24M216 40v24M236 40v24M256 40v24M276 40v24" stroke="#1667C0" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" />
    <path d="M128 46h144M128 54h144" stroke="#fff" stroke-opacity=".25" stroke-width="3" stroke-linecap="round" />
    <path d="M86 76q0-14 14-14h200q14 0 14 14v14q0 10-10 10H96q-10 0-10-10z" fill="url(#cBlue)" />
    <path d="M86 84h228" stroke="#1667C0" stroke-opacity=".5" stroke-width="2" />

    <!-- ऊपरी नीला भाग -->
    <path d="M92 100h216v50H90z" fill="url(#cBlue)" />
    <path d="M92 118h216M91 134h218" stroke="#1667C0" stroke-opacity=".45" stroke-width="2" />

    <!-- सफ़ेद प्रिंटेड पट्टी -->
    <path d="M90 150h220l6 140H84z" fill="url(#cBand)" />
    <g clip-path="url(#bandClip)">
      <path d="M70 205q60-40 130-48" stroke="#B3122E" stroke-width="5" fill="none" stroke-linecap="round" />
      <path d="M70 215q60-40 130-48" stroke="#2EC4D6" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M70 224q60-40 130-48" stroke="#E04B6B" stroke-width="3" fill="none" stroke-linecap="round" opacity=".7" />
      <path d="M200 282q70-6 130-52" stroke="#B3122E" stroke-width="5" fill="none" stroke-linecap="round" />
      <path d="M200 272q70-6 130-52" stroke="#2EC4D6" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M205 263q70-6 125-48" stroke="#E04B6B" stroke-width="3" fill="none" stroke-linecap="round" opacity=".7" />
      <g fill="#DFF6FB" stroke="#7CC6EA" stroke-width="2">
        <rect class="cube c1" x="112" y="240" width="22" height="22" rx="4" />
        <rect class="cube c2" x="264" y="172" width="20" height="20" rx="4" />
        <rect class="cube c3" x="238" y="236" width="16" height="16" rx="3" />
      </g>
      <g class="blooms">
        <circle cx="116" cy="200" r="11" fill="#F28C28" opacity=".85" /><circle cx="116" cy="200" r="4" fill="#FFD23F" />
        <circle cx="282" cy="210" r="13" fill="#E84A7F" opacity=".8" /><circle cx="282" cy="210" r="5" fill="#FFD23F" />
        <circle cx="300" cy="186" r="7" fill="none" stroke="#2EC4D6" stroke-width="3" />
        <circle cx="262" cy="268" r="9" fill="none" stroke="#7B5CD6" stroke-width="3" />
        <circle cx="140" cy="276" r="6" fill="#7B5CD6" opacity=".7" />
        <circle cx="104" cy="230" r="5" fill="none" stroke="#E84A7F" stroke-width="2.5" />
        <path d="M128 200q12-10 22-4M270 210q-10 14-4 26" stroke="#3BA55C" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </g>
      <g fill="#2EC4D6">
        <path d="M120 178c0 0 6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z" />
        <path d="M290 248c0 0 5 6 5 9a5 5 0 0 1-10 0c0-3 5-9 5-9z" />
      </g>
      <g fill="#F5A623"><path class="spark s1" d="M150 252l4 8 8 4-8 4-4 8-4-8-8-4 8-4z" /><path class="spark s2" d="M288 160l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" /></g>
    </g>
    <!-- GPS लेबल -->
    <rect x="148" y="192" width="104" height="58" rx="12" fill="#fff" stroke="#E4EEFB" stroke-width="2" />
    <text x="200" y="228" text-anchor="middle" font-family="Baloo 2, Poppins, sans-serif" font-weight="800" font-size="32" fill="#B3122E">GPS</text>
    <text x="200" y="242" text-anchor="middle" font-family="Mukta, Inter, sans-serif" font-size="9.5" font-weight="700" fill="#0B4F8A" letter-spacing=".5">CHILLED RO WATER</text>

    <!-- निचला नीला भाग -->
    <path d="M84 290h232l-9 113q-1 12-13 12H106q-12 0-13-12z" fill="url(#cBlue)" />
    <path d="M85 300h230" stroke="#1667C0" stroke-opacity=".5" stroke-width="2" />
    <!-- नल के लिए खाँचा -->
    <path d="M164 415v-48q0-34 36-34t36 34v48z" fill="#1667C0" />
    <path d="M170 415v-46q0-28 30-28t30 28v46" fill="none" stroke="#6BB8F8" stroke-opacity=".5" stroke-width="2" />
    <!-- नल -->
    <rect x="192" y="372" width="16" height="30" rx="6" fill="#F4F7FB" stroke="#C9D6E6" stroke-width="1.5" />
    <circle cx="200" cy="364" r="17" fill="#fff" stroke="#C9D6E6" stroke-width="2" />
    <circle cx="200" cy="364" r="9" fill="none" stroke="#2EC4D6" stroke-width="2.5" />
    <circle cx="200" cy="364" r="3" fill="#B3122E" />
    <!-- पैर -->
    <rect x="110" y="412" width="40" height="16" rx="5" fill="#1667C0" />
    <rect x="250" y="412" width="40" height="16" rx="5" fill="#1667C0" />

    <!-- चमक -->
    <path d="M104 108v34M100 160l-4 120M100 304l6 96" stroke="#fff" stroke-opacity=".35" stroke-width="8" stroke-linecap="round" />

    <!-- ठंडक की बूँदें (कंडेन्सेशन) -->
    <g fill="#fff" opacity=".85">
      <path class="drip d1" d="M280 110c0 0 5 6 5 9a5 5 0 0 1-10 0c0-3 5-9 5-9z" />
      <path class="drip d2" d="M128 302c0 0 4 5 4 8a4 4 0 0 1-8 0c0-3 4-8 4-8z" />
      <path class="drip d3" d="M286 318c0 0 5 6 5 9a5 5 0 0 1-10 0c0-3 5-9 5-9z" />
    </g>

    <!-- नल से टपकती बूँदें -->
    <g fill="#9BE7F5">
      <path class="tap-drop t1" d="M200 400c0 0 4 5 4 8a4 4 0 0 1-8 0c0-3 4-8 4-8z" />
      <path class="tap-drop t2" d="M200 400c0 0 4 5 4 8a4 4 0 0 1-8 0c0-3 4-8 4-8z" />
    </g>

    <!-- बाहर तैरते बर्फ़ के टुकड़े -->
    <g fill="#DFF6FB" opacity=".95">
      <rect class="float f1" x="22" y="330" width="52" height="52" rx="9" />
      <rect class="float f2" x="326" y="350" width="44" height="44" rx="8" />
      <rect class="float f3" x="330" y="120" width="28" height="28" rx="6" opacity=".7" />
    </g>
    <g fill="#fff">
      <path class="spark s3" d="M48 150l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
      <path class="spark s4" d="M352 250l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" />
    </g>
  </svg>
</div>

<style>
  .hero-art svg * { transform-box: fill-box; transform-origin: center; }
  .tap-drop { opacity: 0; animation: tap 2.4s ease-in infinite; }
  .t2 { animation-delay: 1.2s; }
  @keyframes tap {
    0% { opacity: 0; transform: translateY(0) scale(.4); }
    15% { opacity: 1; transform: translateY(0) scale(1); }
    60% { opacity: 1; transform: translateY(20px); }
    75%, 100% { opacity: 0; transform: translateY(24px) scaleX(1.6) scaleY(.3); }
  }
  .drip { animation: drip 6s ease-in infinite; }
  .d2 { animation-delay: 2s; }
  .d3 { animation-delay: 4s; }
  @keyframes drip {
    0%, 20% { opacity: 0; transform: translateY(0); }
    30% { opacity: .9; }
    80% { opacity: .9; transform: translateY(46px); }
    100% { opacity: 0; transform: translateY(54px); }
  }
  .float { animation: float 5s ease-in-out infinite; }
  .f2 { animation-delay: -1.7s; animation-duration: 6s; }
  .f3 { animation-delay: -3s; animation-duration: 7s; }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-10deg); }
    50% { transform: translateY(-14px) rotate(8deg); }
  }
  .cube { animation: cube 4s ease-in-out infinite; }
  .c2 { animation-delay: -1.3s; }
  .c3 { animation-delay: -2.6s; }
  @keyframes cube { 50% { transform: translateY(-4px) rotate(10deg); } }
  .spark { animation: twinkle 2.8s ease-in-out infinite; }
  .s2 { animation-delay: -.7s; }
  .s3 { animation-delay: -1.4s; }
  .s4 { animation-delay: -2.1s; }
  @keyframes twinkle {
    0%, 100% { opacity: .2; transform: scale(.6) rotate(0); }
    50% { opacity: 1; transform: scale(1.1) rotate(45deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art svg * { animation: none !important; }
    .tap-drop { opacity: 0; }
  }
</style>
