---
// लिंक प्रीव्यू इमेज (public/og-image.jpg) का सोर्स।
// दोबारा बनाने के लिए: इसे src/pages/og-card.astro में कॉपी करें, `npm run dev` चलाएँ,
// http://localhost:4321/og-card का 1200×630 स्क्रीनशॉट लें, फिर पेज हटा दें।
import '../styles/global.css';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
---
<html lang="en" data-lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Baloo+2:wght@800&display=swap" />
  <style>
    html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; padding: 0; }
    .og { position: relative; width: 1200px; height: 630px; overflow: hidden; color: #fff; font-family: Inter, sans-serif;
      background: radial-gradient(700px 480px at 82% 45%, rgba(46,196,214,.38), transparent 62%),
        radial-gradient(600px 300px at 10% 110%, rgba(46,196,214,.18), transparent 60%),
        linear-gradient(160deg, #0D5797 0%, #0A4479 50%, #072F55 100%); }
    .og::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.08) 1px, transparent 1px); background-size: 22px 22px; }
    .left { position: absolute; left: 64px; top: 48px; width: 690px; }
    .brand { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
    .brand .mark { font: 800 34px/1 'Baloo 2', sans-serif; background: #B3122E; padding: 12px 14px 8px; border-radius: 14px; box-shadow: 0 8px 20px -6px rgba(179,18,46,.6); }
    .brand b { display: block; font: 700 26px/1.1 Poppins, sans-serif; }
    .brand small { font-size: 17px; color: #BCD6EC; }
    h1 { margin: 0; font: 700 60px/1.08 Poppins, sans-serif; letter-spacing: -.015em; color: #fff; }
    .tag { margin: 12px 0 20px; font: 600 32px/1.2 Poppins, sans-serif; background: linear-gradient(90deg, #7FE3F0, #2EC4D6 60%, #A8EEF7); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
    .chips span { font-size: 17px; font-weight: 500; padding: 6px 13px; border-radius: 99px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); }
    .cta { display: flex; gap: 14px; align-items: center; }
    .pill { display: inline-flex; align-items: center; gap: 10px; font: 700 24px/1 Inter, sans-serif; padding: 16px 26px; border-radius: 99px; }
    .wa { color: #2A1600; background: linear-gradient(135deg, #FFD15C, #FFB020 50%, #FF9500); box-shadow: 0 12px 28px -10px rgba(255,149,0,.75), inset 0 1px 0 rgba(255,255,255,.45); }
    .call { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.35); }

    /* नीचे का पैनल */
    .panel { position: absolute; left: 64px; bottom: 34px; display: flex; align-items: stretch; border-radius: 22px; overflow: hidden;
      background: linear-gradient(135deg, rgba(255,255,255,.14), rgba(255,255,255,.05) 55%, rgba(46,196,214,.12));
      border: 1px solid rgba(255,255,255,.2); box-shadow: 0 18px 40px -18px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.18); }
    .cell { display: flex; align-items: center; gap: 14px; padding: 14px 24px; }
    .cell + .cell { border-left: 1px solid rgba(255,255,255,.14); }
    .cell small { display: block; font-size: 12.5px; font-weight: 600; letter-spacing: .14em; color: #8FD9E6; margin-bottom: 3px; }
    .cell b { display: block; font: 600 19px/1.2 Inter, sans-serif; white-space: nowrap; }
    .cell.owner { padding-left: 14px; background: linear-gradient(90deg, rgba(46,196,214,.16), transparent); }
    .cell.owner b { font: 700 25px/1.15 Poppins, sans-serif; letter-spacing: -.005em; }
    .av { position: relative; flex-shrink: 0; width: 58px; height: 58px; border-radius: 50%; padding: 3px;
      background: conic-gradient(from 200deg, #7FE3F0, #2EC4D6, #ffffff, #7FE3F0); }
    .av span { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; font: 700 21px/1 Poppins, sans-serif;
      background: linear-gradient(135deg, #17A9C4, #0B4F8A); box-shadow: inset 0 0 0 2px rgba(7,47,85,.6); }
    .av i { position: absolute; right: -2px; bottom: -2px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
      background: #25D366; border: 2px solid #0A4479; color: #06361A; }
    .ic { flex-shrink: 0; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; color: #7FE3F0;
      background: rgba(46,196,214,.14); border: 1px solid rgba(46,196,214,.3); }

    .art { position: absolute; right: 24px; top: 30px; width: 440px; }
    .art .hero-art { max-width: 440px !important; }
    .art svg * { animation: none !important; }
  </style>
</head>
<body>
  <div class="og">
    <div class="left">
      <div class="brand"><span class="mark">GPS</span><span><b>Water Services</b><small>Chilled R.O. Water · GPS Pure Ice</small></span></div>
      <h1>GPS Chilled R.O. Water</h1>
      <div class="tag">A symbol of purity and quality</div>
      <div class="chips"><span>18 L RO Jars</span><span>Ice Slabs</span><span>Packaged Water Bottles</span><span>Water Pouches</span></div>
      <div class="cta">
        <span class="pill wa"><Icon name="truck" size={26} /> Order Now</span>
        <span class="pill call"><Icon name="phone" size={24} /> Call {business.phone}</span>
      </div>
    </div>
    <div class="panel">
      <div class="cell owner">
        <span class="av"><span>VT</span><i><Icon name="check" size={12} /></i></span>
        <span><small>PROPRIETOR</small><b>{business.owner.en}</b></span>
      </div>
      <div class="cell">
        <span class="ic"><Icon name="pin" size={20} /></span>
        <span><small>HOME DELIVERY</small><b>Kusumkasa · Balod</b></span>
      </div>
      <div class="cell">
        <span class="ic"><Icon name="shield" size={20} /></span>
        <span><small>CERTIFIED</small><b>{business.certificate}</b></span>
      </div>
    </div>
    <div class="art"><HeroArt /></div>
  </div>
</body>
</html>
